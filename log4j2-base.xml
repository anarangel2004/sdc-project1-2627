<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout noConsoleNoAnsi="true"
                pattern="%d{HH:mm:ss.SSS} %highlight{%-5level}{FATAL=bg_red, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan} [%t] %style{%logger{1.}}{cyan} - %msg%n" />
        </Console>
        <File name="File" fileName="output.log" bufferedIO="true">
            <PatternLayout
                pattern="%d{HH:mm:ss.SSS} [%t] %logger{1.} - %msg%n" />
        </File>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console" />
            <!--AppenderRef
            ref="File"/-->
        </Root>
    </Loggers>
</Configuration>